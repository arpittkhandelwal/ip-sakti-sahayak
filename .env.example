# Sarvam AI API Key (required)
SARVAM_API_KEY=your_sarvam_api_key_here

# Sarvam Model Names (optional - these are the defaults)
SARVAM_CHAT_MODEL=sarvam-m
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_STT_MODEL=saarika:v2
SARVAM_TTS_MODEL=bulbul:v1
SARVAM_LID_MODEL=lid

# Feature Flags
VITE_ENABLE_VOICE=false
VITE_ENABLE_LLM_RERANK=false

# BM25 / Retrieval Config
TOP_K=5
LLM_RERANK_TOP_N=4
MIN_SCORE_THRESHOLD=0.5

# Rate Limiting
RATE_LIMIT_RPM=20
INPUT_MAX_CHARS=2000
